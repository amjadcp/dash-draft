{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-wasm": "node -e \"const fs = require('fs'); const path = require('path'); const sqlJsDir = path.dirname(require.resolve('sql.js')); const src = path.join(sqlJsDir, 'sql-wasm.wasm'); const destDir = path.join(process.cwd(), 'public'); fs.mkdirSync(destDir, { recursive: true }); fs.copyFileSync(src, path.join(destDir, 'sql-wasm.wasm'));\"",
    "predev": "pnpm copy-wasm",
    "prebuild": "pnpm copy-wasm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/**/*.{ts,tsx}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/mcp-contracts": "workspace:*",
    "@types/papaparse": "^5.5.2",
    "@types/sql.js": "^1.4.11",
    "lucide-react": "^0.378.0",
    "nuqs": "^2.9.5",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
